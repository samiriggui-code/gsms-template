# Production URLs for `npm run build` (copy to .env.production.local) or repo-root .env Docker build args.
NEXT_PUBLIC_SITE_URL=https://www.global-it-ss.com
NEXT_PUBLIC_APP_URL=https://app.global-it-ss.com
# Optional: public Core /api/v1 (poles, appointments). Omit for static fallback only.
NEXT_PUBLIC_API_URL=https://api.global-it-ss.com
